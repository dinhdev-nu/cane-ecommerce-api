# systemd EnvironmentFile syntax. Root-owned 0600; never source or commit real values.
CANE_DB_URL=jdbc:postgresql://127.0.0.1:55432/cane_staging
CANE_DB_USER=cane_api
CANE_DB_PASSWORD=<API-secret-from-staging-infrastructure>
CANE_REDIS_HOST=127.0.0.1
CANE_REDIS_PORT=16379
CANE_REDIS_USER=cane_runtime
CANE_REDIS_PASSWORD=<Redis-secret-from-staging-infrastructure>
CANE_API_PORT=8080
PUBLIC_ORIGIN=https://__STAGING_HOST__
# This exact range is for the proposed proxy running on the same host, via IPv4 loopback.
CANE_TRUSTED_PROXIES=127.0.0.1/32
LINK_SECRETS='{"__KID__":"__RANDOM_BASE64URL_KEY__"}'
LINK_ACTIVE_KID=__KID__
