# Placeholders only. scripts/New-LocalEnvironment.ps1 generates .local/dev.env.
CANE_POSTGRES_ADMIN_PASSWORD=<random-local-admin-secret>
CANE_MIGRATION_PASSWORD=<random-local-migration-secret>
CANE_API_DB_PASSWORD=<random-local-api-secret>
CANE_WORKER_DB_PASSWORD=<random-local-worker-secret>
CANE_REDIS_PASSWORD=<random-local-redis-secret>
CANE_POSTGRES_PORT=55432
CANE_REDIS_PORT=16379
CANE_API_PORT=8080
# Empty trusts no proxy. Set only the actual numeric IP/CIDR ranges of controlled proxies.
# Run-Local.ps1 inherits this from the process environment, not dev.env.
CANE_TRUSTED_PROXIES=
# Run-Local.ps1 derives CANE_DB_URL/USER/PASSWORD and Redis connection variables.
# For CI or direct java -jar execution, explicitly supply:
# CANE_DB_URL=jdbc:postgresql://127.0.0.1:55432/cane_local
# CANE_DB_USER=cane_api (or cane_worker)
# CANE_DB_PASSWORD=<password-of-that-runtime-role>
# CANE_REDIS_HOST=127.0.0.1
# CANE_REDIS_USER=cane_runtime
# CANE_REDIS_PASSWORD=<random-local-redis-secret>
# CANE_REDIS_PORT=16379
# Migration is a separate command, using CANE_MIGRATION_URL/USER/PASSWORD.
